{
  "name": "nizek-projects-plus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "dev:backend:anonymous": "CONVEX_AGENT_MODE=anonymous convex dev",
    "seed": "convex run seed:importExport",
    "build": "tsc -b && vite build",
    "build:vercel": "convex deploy --cmd-url-env-var-name VITE_CONVEX_URL --cmd 'npm run build'",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "convex": "^1.48.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
