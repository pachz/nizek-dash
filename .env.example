# Local Convex (filled by `npx convex dev`)
# VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Vercel only — do not commit real keys
# CONVEX_DEPLOY_KEY=prod:xxxxx

# Convex dashboard env (npx convex env set OPENAI_API_KEY sk-...)
# Used by matchActions for AI commit↔task matching. Not a Vite var.
# OPENAI_API_KEY=

# GitHub PAT is stored in Admin → settings (not env).

# Nizek Docs UI (internal-tools). Release Maker opens / imports here.
# Local API generate calls always hit http://127.0.0.1:8787.
# If Vite gave Docs another port (e.g. 5174), set that here.
# VITE_NIZEK_DOCS_URL=http://127.0.0.1:5173
